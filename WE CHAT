const searchMessages = async (query) => {
  const snapshot = await firestore()
    .collection('Chats')
    .where('text', '>=', query)
    .where('text', '<=', query + '\uf8ff')
    .get();

  const results = snapshot.docs.map(doc => doc.data());
  setMessages(results);
};
